# Copy this file to .env and fill in your own key (never commit the real .env).
# Get a key by subscribing to "TennisApi" on RapidAPI:
# https://rapidapi.com/fluis.lacasse/api/tennisapi1
#
# Without this set, the app runs fine on the curated CSV alone --
# live per-player stats are purely additive.
RAPIDAPI_KEY=
